{
  "$schema": "https://specs.frictionlessdata.io/schemas/table-schema.json",
  "name": "profile-clause_bindings",
  "title": "profile/clause_bindings.csv",
  "description": "The claim that this jurisdiction grounds this requirement in this clause. The file that makes CIEO portable.",
  "fields": [
    {
      "name": "requirement_id",
      "type": "string",
      "constraints": {
        "required": true
      },
      "cieo:references": {
        "table": "core/requirements.csv",
        "field": "requirement_id"
      }
    },
    {
      "name": "regulation_id",
      "type": "string",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "clause_reference",
      "type": "string",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "binding_status",
      "type": "string",
      "constraints": {
        "required": true,
        "enum": [
          "VERIFIED",
          "PROPOSED",
          "UNMAPPED",
          "NOT_APPLICABLE"
        ]
      }
    },
    {
      "name": "confidence",
      "type": "string",
      "constraints": {
        "required": false,
        "enum": [
          "HIGH",
          "MEDIUM",
          "LOW",
          "TO_VERIFY"
        ]
      }
    },
    {
      "name": "source_url",
      "type": "string",
      "constraints": {
        "required": false
      },
      "format": "uri"
    },
    {
      "name": "note",
      "type": "string",
      "constraints": {
        "required": false
      }
    }
  ]
}
